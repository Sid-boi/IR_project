# Copy this file to .env before running docker compose:
#   cp .env.example .env

# Elasticsearch version — matches the course installation PDF
ES_VERSION=7.17.28

# Heap size. 1g works on 8GB machines. Raise to 2g if you have 16GB+.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Container memory cap. Keep roughly 2x the heap.
ES_MEM_LIMIT=2g

# Index names — leave as-is unless you want parallel experiments
ES_INDEX=medline
ES_INDEX_ENRICHED=medline_enriched
